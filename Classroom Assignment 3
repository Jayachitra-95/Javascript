Corrected answer :
// 1. Create function with a parameter
function isOddOrEven(number) { 
    
    // 3. Use a conditional statement to check divisibility by 2
    // Use === for comparison
    if (number % 2 === 0) {
        return "Even";
    } else {
        return "Odd";
    }
}

// 2. Declare and initialize the variable
var myNumber = 10; 

// 4. Call the function and print the result
var result = isOddOrEven(myNumber);
console.log("The number " + myNumber + " is " + result);




