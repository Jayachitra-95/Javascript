corrected answer :
function launchBrowser(browser) {
    // Removed the extra space in "CHROME"
    if (browser === "CHROME") {
        console.log("CHROME");
    } else {
        console.log(browser);
    }
}

function runTests(testType) {
    // Use curly braces for switch
    switch (testType) {
        case 'SMOKE':
            console.log('SMOKE TEST');
            break; // No parentheses
        case 'SANITY':
            console.log('SANITY TEST');
            break;
        case 'REGRESSION':
            console.log('REGRESSION TEST');
            break;
        default:
            console.log('Unknown Test Type');
    }
}

var browser = "CHROME";
launchBrowser(browser); // Prints: CHROME

var TEST = "SANITY";
runTests(TEST); // Prints: SANITY TEST


