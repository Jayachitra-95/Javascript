using split :

let myString = "racecar";

function checkPalindrome(str) {
    let characters = str.split(""); 
    let reversedStr = "";

    for (let i = characters.length - 1; i >= 0; i--) {
        reversedStr += characters[i]; 
    }

    if (reversedStr === str) {
        return true;
    } else {
        return false;
    }
}

console.log("Is it a palindrome?", checkPalindrome(myString));






