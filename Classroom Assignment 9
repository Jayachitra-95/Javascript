so correct code :
function isAnagram(str1, str2) {
    let cleanStr1 = str1.trim().toLowerCase();
    let cleanStr2 = str2.trim().toLowerCase();

    if (cleanStr1.length !== cleanStr2.length) {
        return false;
    }

    // You must sort the SPLIT array, not the string!
    let split1 = cleanStr1.split("");
    let sort1 = split1.sort(); // Use the array 'split1'
    let join1 = sort1.join(""); // Join it back to compare

    let split2 = cleanStr2.split("");
    let sort2 = split2.sort(); // Use the array 'split2'
    let join2 = sort2.join("");

    // Compare the final joined strings
    return join1 === join2;
}

console.log(isAnagram('listen', 'silent')); // true
console.log(isAnagram('hello', 'world'));   // false
